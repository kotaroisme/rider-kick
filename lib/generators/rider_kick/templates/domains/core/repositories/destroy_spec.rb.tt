# frozen_string_literal: true

require "rails_helper"

RSpec.describe <%= domain_class_name %>::Repositories::<%= @scope_class %>::<%= @repository_class %>, type: :repository do
  describe "#call" do

<% if @resource_owner_id.present? -%>
    let(:<%= @resource_owner %>) { create(:<%= @resource_owner %>)}
    let(:<%= @resource_owner_id %>) { <%= @resource_owner %>.id }
<% end -%>
<% @fields.each do |field| -%>
<% next if @resource_owner_id.present? && field == @resource_owner_id -%>
<% field_meta = columns_meta.find { |col| col[:name] == field } -%>
<% if field_meta && field_meta[:type] == :uuid -%>
    let(:<%= field.delete_suffix("_id") %>) { create(:<%= field.delete_suffix("_id") %>, <%= @resource_owner %>: <%= @resource_owner %>) }
    let(:<%= field %>) { <%= field.delete_suffix("_id") %>.id }
<% end -%>
<% end -%>

<% if @resource_owner_id.present? -%>
    let!(:<%= @variable_subject %>) do
      create(:<%= @variable_subject %>,
        <%= @resource_owner_id %>: <%= @resource_owner_id %>,
<% @fields.each do |field| -%>
<% next if field == @resource_owner_id -%>
<% field_meta = columns_meta.find { |col| col[:name] == field } -%>
<% if field_meta && field_meta[:type] == :uuid -%>
        <%= field %>: <%= field %>,
<% end -%>
<% end -%>
      )
    end
<% else -%>
    let!(:<%= @variable_subject %>) do
      create(:<%= @variable_subject %>,
<% @fields.each do |field| -%>
<% field_meta = columns_meta.find { |col| col[:name] == field } -%>
<% if field_meta && field_meta[:type] == :uuid -%>
        <%= field %>: <%= field %>,
<% end -%>
<% end -%>
      )
    end
<% end -%>


    let(:params) do
      Hashie::Mash.new({
        id: <%= @variable_subject %>.id<% if @resource_owner_id.present? && @has_resource_owner_id_in_destroy_contract %>,
        <%= @resource_owner_id %>: <%= @resource_owner_id %><% end %>
      })
    end

    subject(:repository) { described_class.new(params: params) }

    context "with valid params" do
      it "must valid contract" do
        expect(<%= domain_class_name %>::UseCases::<%= [@route_scope_class, @scope_class, @use_case_class].reject { |c| c.empty? }.join("::") %>.contract!(params)).to be_success
      end
    end

    context "when <%= @variable_subject %> exists" do
      it "returns success with message", :aggregate_failures do
        result = repository.call

        expect(result).to be_success
        expect(result.success).to eq("<%= @subject_class %> Destroyed.")
      end

      it "removes from database" do
        expect { repository.call }.to change(<%= @model_class %>, :count).by(-1)
      end

      it "actually deletes the record" do
        <%= @variable_subject %>_id = <%= @variable_subject %>.id

        repository.call

        expect(<%= @model_class %>.find_by(id: <%= @variable_subject %>_id)).to be_nil
      end
    end

    context "when <%= @variable_subject %> does not exist" do
      let(:params) do
        Hashie::Mash.new({
          id: SecureRandom.uuid<% if @resource_owner_id.present? && @has_resource_owner_id_in_destroy_contract %>,
          <%= @resource_owner_id %>: <%= @resource_owner_id %><% end %>
        })
      end

      it "returns failure with not found message", :aggregate_failures do
        result = repository.call

        expect(result).to be_failure
        expect(result.failure).to eq("<%= @subject_class %> not found")
      end

      it "does not change database" do
        expect { repository.call }.not_to change(<%= @model_class %>, :count)
      end
    end

<% if @resource_owner_id.present? && @has_resource_owner_id_in_destroy_contract -%>
    context "when <%= @variable_subject %> belongs to different <%= @resource_owner_id.gsub('_id', '') %>" do
      let(:other_<%= @resource_owner_id %>) { SecureRandom.uuid }
      let(:params) do
        Hashie::Mash.new({
          id: <%= @variable_subject %>.id,
          <%= @resource_owner_id %>: other_<%= @resource_owner_id %>
        })
      end

      it "returns failure (<%= @resource_owner_id.gsub('_id', '') %> isolation)", :aggregate_failures do
        result = repository.call

        expect(result).to be_failure
        expect(result.failure).to eq("<%= @subject_class %> not found")
      end

      it "does not delete the record" do
        expect { repository.call }.not_to change(<%= @model_class %>, :count)
      end

      it "record still exists in database" do
        repository.call

        expect(<%= @model_class %>.find_by(id: <%= @variable_subject %>.id)).to be_present
      end
    end
<% end -%>
  end
end
