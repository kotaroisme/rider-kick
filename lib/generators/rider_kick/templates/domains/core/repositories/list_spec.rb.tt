# frozen_string_literal: true

require "rails_helper"

RSpec.describe <%= domain_class_name %>::Repositories::<%= @scope_class %>::<%= @repository_class %>, type: :repository do
  describe "#call" do
<% if @resource_owner_id.present? -%>
    let(:<%= @resource_owner %>) { create(:<%= @resource_owner %>) }
    let(:<%= @resource_owner_id %>) { <%= @resource_owner %>.id }

    let(:other_<%= @resource_owner %>) { create(:<%= @resource_owner %>) }
    let(:other_<%= @resource_owner_id %>) { other_<%= @resource_owner %>.id }

<% @fields.each do |field| -%>
<% next if @resource_owner_id.present? && field == @resource_owner_id -%>
<% field_meta = columns_meta.find { |col| col[:name] == field } -%>
<% if field_meta && field_meta[:type] == :uuid -%>
    let(:<%= field.delete_suffix("_id") %>) { create(:<%= field.delete_suffix("_id") %>, <%= @resource_owner %>: <%= @resource_owner %>)}
    let(:<%= field %>) { <%= field.delete_suffix("_id") %>.id }
<% end -%>
<% end -%>

    let!(:<%= @variable_subject %>_recent) { create(:<%= @variable_subject %>, <%= @resource_owner_id %>: <%= @resource_owner_id %>, created_at: 1.hour.ago) }
    let!(:<%= @variable_subject %>_middle) { create(:<%= @variable_subject %>, <%= @resource_owner_id %>: <%= @resource_owner_id %>, created_at: 2.hours.ago) }
    let!(:<%= @variable_subject %>_oldest) { create(:<%= @variable_subject %>, <%= @resource_owner_id %>: <%= @resource_owner_id %>, created_at: 3.hours.ago) }
    let!(:other_<%= @resource_owner_id.gsub('_id', '') %>_<%= @variable_subject %>) { create(:<%= @variable_subject %>, <%= @resource_owner_id %>: other_<%= @resource_owner_id %>) }
<% else -%>
    let!(:<%= @variable_subject %>_recent) { create(:<%= @variable_subject %>, created_at: 1.hour.ago) }
    let!(:<%= @variable_subject %>_middle) { create(:<%= @variable_subject %>, created_at: 2.hours.ago) }
    let!(:<%= @variable_subject %>_oldest) { create(:<%= @variable_subject %>, created_at: 3.hours.ago) }
<% end -%>

    let(:page) { 1 }
    let(:per_page) { 10 }
    let(:params) do
      Hashie::Mash.new({
<% if @resource_owner_id.present? -%>
        <%= @resource_owner_id %>: <%= @resource_owner_id %>,
<% end -%>
        page: page,
        per_page: per_page
      })
    end

    subject(:result) { described_class.new(params: params).call }

    context "with valid params" do
      it "must valid contract" do
        expect(<%= domain_class_name %>::UseCases::<%= [@route_scope_class, @scope_class, @use_case_class].reject { |c| c.empty? }.join("::") %>.contract!(params)).to be_success
      end

      it "returns success" do
        expect(result).to be_success
      end

<% if @resource_owner_id.present? -%>
      it "returns only <%= @scope_path %> for specified <%= @resource_owner_id.gsub('_id', '') %>" do
        response = result.success[:response]

        expect(response.size).to eq(3)
        expect(response.map(&:id)).to contain_exactly(
          <%= @variable_subject %>_recent.id,
          <%= @variable_subject %>_middle.id,
          <%= @variable_subject %>_oldest.id
        )
      end

      it "does not include <%= @scope_path %> from other <%= @resource_owner_id.gsub('_id', '').pluralize %>" do
        response = result.success[:response]

        expect(response.map(&:id)).not_to include(other_<%= @resource_owner_id.gsub('_id', '') %>_<%= @variable_subject %>.id)
      end
<% else -%>
      it "returns all <%= @scope_path %>" do
        response = result.success[:response]

        expect(response.size).to eq(3)
        expect(response.map(&:id)).to contain_exactly(
          <%= @variable_subject %>_recent.id,
          <%= @variable_subject %>_middle.id,
          <%= @variable_subject %>_oldest.id
        )
      end
<% end -%>

      it "orders by created_at descending" do
        response = result.success[:response]

        expect(response.map(&:id)).to eq([
          <%= @variable_subject %>_recent.id,
          <%= @variable_subject %>_middle.id,
          <%= @variable_subject %>_oldest.id
        ])
      end

      it "returns correct pagination meta", :aggregate_failures do
        meta = result.success[:meta]

        expect(meta).to be_a(<%= domain_class_name %>::Entities::Pagination)
        expect(meta.page).to eq(1)
        expect(meta.total_count).to eq(3)
        expect(meta.per_page).to eq(10)
      end

      it "returns entities not models" do
        response = result.success[:response]

        response.each do |item|
          expect(item).to be_a(<%= domain_class_name %>::Entities::<%= @subject_class %>)
        end
      end
    end

    context "with pagination" do
      let(:per_page) { 1 }

      context "page 1" do
        let(:page) { 1 }

        it "returns first record only" do
          response = result.success[:response]

          expect(response.size).to eq(1)
          expect(response.first.id).to eq(<%= @variable_subject %>_recent.id)
        end

        it "returns correct pagination meta", :aggregate_failures do
          meta = result.success[:meta]

          expect(meta.page).to eq(1)
          expect(meta.total_count).to eq(3)
          expect(meta.page_count).to eq(3)
        end
      end

      context "page 2" do
        let(:page) { 2 }

        it "returns second record" do
          response = result.success[:response]

          expect(response.size).to eq(1)
          expect(response.first.id).to eq(<%= @variable_subject %>_middle.id)
        end
      end

      context "page 3" do
        let(:page) { 3 }

        it "returns third record" do
          response = result.success[:response]

          expect(response.size).to eq(1)
          expect(response.first.id).to eq(<%= @variable_subject %>_oldest.id)
        end
      end

      context "page out of range" do
        let(:page) { 99 }

        it "returns empty array", :aggregate_failures do
          expect(result.success[:response]).to be_empty
        end

        it "keeps correct total count" do
          expect(result.success[:meta].total_count).to eq(3)
        end
      end
    end

<% if @resource_owner_id.present? -%>
    context "when <%= @resource_owner_id.gsub('_id', '') %> has no data" do
      let(:empty_<%= @resource_owner_id %>) { '<%= SecureRandom.uuid %>' }
      let(:params) do
        Hashie::Mash.new({
          <%= @resource_owner_id %>: empty_<%= @resource_owner_id %>,
          page: 1,
          per_page: 10
        })
      end

      it "returns empty response", :aggregate_failures do
        expect(result.success[:response]).to eq([])
        expect(result.success[:meta]).to eq({})
      end
    end
<% else -%>
    context "when no resources exist" do
      before do
        <%= @model_class %>.destroy_all
      end

      it "returns empty response", :aggregate_failures do
        expect(result.success[:response]).to eq([])
        expect(result.success[:meta]).to eq({})
      end
    end
<% end -%>
  end
end
